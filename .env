# MongoDB manzili. Lokal: mongodb://127.0.0.1:27017/shop  yoki Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/shop
# Ulanib bo'lmasa yoki bo'sh qoldirilsa, avtomatik lokal JSON baza (data/db.json) ishlatiladi.
MONGODB_URI=mongodb://127.0.0.1:27017/shop

# Sessiya cookie imzosi uchun maxfiy kalit. Productionda albatta almashtiring!
AUTH_SECRET=shop-dev-secret-change-me-please-0123456789
# Sayt manzili (SEO / havolalar uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
